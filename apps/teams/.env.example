# Teams install (Path A: standalone SPCS service + Cloudflare Worker, NETWORK_MODE=public).
# Copy to apps/teams/.env and fill in the REQUIRED section. Never commit .env.
# Other settings live in their own templates:
#   .env.dev.example        local dev server and tab
#   .env.test.example       Teams e2e / token refresh
#   .env.node-edge.example  self-hosted Node edge (instead of Cloudflare)

# ============================ REQUIRED ============================

# --- Snowflake ---
# Account identifier without .snowflakecomputing.com, e.g. abc12345.eu-west-2.aws.
# The value the SPCS service uses is different - see native-app/services/service_spec.yml.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=AGENTS_TEAMS_SVC
# Programmatic Access Token for SNOWFLAKE_USER, minted with ROLE_RESTRICTION.
SNOWFLAKE_PAT=
# Target Cortex agent, DB.SCHEMA.AGENT_NAME.
DEFAULT_AGENT_FQN=
# Snowflake apps API host for your account's region (fill-dev-secrets.sh).
APPS_API_HOST=apps-api.c1.<region>.<cloud>.app.snowflake.com

# --- Microsoft Entra ---
AZURE_TENANT_ID=
# Azure Bot app registration.
BOT_APP_ID=
BOT_APP_SECRET=
# Tab SSO / on-behalf-of app registration (may be the same app as the bot).
OBO_CLIENT_ID=
OBO_CLIENT_SECRET=
# Snowflake OAuth resource app (needs the `upn` optional claim) and its scope.
SNOWFLAKE_ENTRA_APP_ID=
SNOWFLAKE_SCOPE=api://<snowflake-app-id>/session:role-any
# GUID for the Teams app manifest. Any new GUID works (e.g. uuidgen).
TEAMS_APP_ID=

# --- Hosting ---
# Cloudflare Worker origin: a custom domain or <worker>.<subdomain>.workers.dev.
# TAB_BASE_HOST is the hostname only; TAB_BASE_URL is the https origin. No trailing slash.
TAB_BASE_HOST=<your-edge-host>
TAB_BASE_URL=https://<your-edge-host>
# Public SPCS ingress hostname (no scheme); used for the manifest validDomains.
SPCS_INGRESS_HOST=<instance>-<org>-<account>.snowflakecomputing.app
# Cloudflare API token (Workers Scripts: Edit). deploy-tab.sh and set-edge-secrets.sh export it
# to wrangler. Keep it here in the untracked .env only.
CLOUDFLARE_API_TOKEN=

# ============================ OPTIONAL ============================
# Defaults shown. Uncomment only to override.

# public (default) | hybrid | privatelink. privatelink needs SPCS_BASE.
# NETWORK_MODE=public
# Full https SPCS ingress URL. Required for privatelink (privatelink_ingress_url from SHOW ENDPOINTS).
# SPCS_BASE=
# Cloudflare KV namespace id for BOT_LINKS (32 hex). deploy-tab.sh --create finds or creates it and writes it here.
# BOT_LINKS_KV_ID=
# Custom domain for the Worker (bare hostname on a zone in this Cloudflare account). deploy-tab.sh adds the route.
# EDGE_CUSTOM_DOMAIN=
# privatelink only: Workers VPC service id from `wrangler vpc service create`.
# SPCS_VPC_SERVICE_ID=
# Docker push registry host. Default: ${SNOWFLAKE_ACCOUNT//_/-}.registry.snowflakecomputing.com
# SNOWFLAKE_REGISTRY_HOST=
# Pin the user token to one role (scope api://<snowflake-app-id>/session:role:<ROLE>).
# Blank = role-any. The Entra Snowflake app must expose that scope.
# SNOWFLAKE_OAUTH_ROLE=
# JSON [{"fqn","displayName"}]. A fixed agent list instead of dynamic SHOW AGENTS discovery.
# AGENT_ALLOW_LIST=
# Comma-separated Entra client IDs accepted as azp/appid. Default: the Teams desktop/mobile and web clients.
# ENTRA_ALLOWED_CLIENT_IDS=
# ENTRA_REQUIRED_SCOPE=access_as_user
# Subscription for the Bot Framework resource (set-bot-endpoint.sh). Only needed with several subscriptions.
# AZURE_SUBSCRIPTION_ID=
# HMAC key to verify bot share links (?sig=). Links must be signed server-side.
# SHARE_SIGNING_SECRET=
# Set to 1 ONLY while debugging: logs user queries and agent FQNs.
# BOT_DEBUG_LOG_QUERIES=
# Trust X-Forwarded-For for container rate-limit buckets. Default off: only
# X-Agents-Client-Ip (set by the edge) is used. Enable only if callers reach
# SPCS behind a hop count you control, without the edge.
# RATE_LIMIT_TRUST_XFF=

# ============================ AUTO ============================
# Generated or derived by the scripts. Leave commented; set only to override.

# set-edge-secrets.sh generates and appends these if absent. Rotating BOT_LINK_SECRET signs every bot user out.
# EDGE_SESSION_SECRET=
# BOT_LINK_SECRET=
# fill-dev-secrets.sh derives the CORS allowlist from TAB_BASE_HOST.
# ALLOWED_ORIGINS=
# Extra Entra audience; defaults to api://<TAB_BASE_HOST>/<OBO_CLIENT_ID>.
# ENTRA_AUDIENCE_URI=
# Worker name; defaults to the first label of a *.workers.dev TAB_BASE_HOST, else agents-embed-teams.
# EDGE_WORKER_NAME=
