# Local development only (npm run dev:server / dev:tab). Not needed for an install.
# Add these to apps/teams/.env alongside the keys from .env.example.

# 'local-pat' (PAT from SNOWFLAKE_PAT), 'local-oauth', or 'production'.
# Required at boot: an omitted or misspelled value is a startup error.
TEAMS_AUTH_MODE=local-pat
PORT=3000

# Tab build-time vars. Put them in packages/tab/.env.development.local (git-ignored), NOT
# .env.local: Vite loads .env.local in production builds too, which would leak the PAT.
# VITE_AUTH_MODE=local-pat        # skip Teams SSO, send X-Snowflake-Pat instead
# VITE_SPCS_BASE=                 # empty => relative /api/... against the local server
# VITE_SNOWFLAKE_PAT=<dev-pat>
# Production builds: packages/tab/.env.production, baked in at `vite build`.
# VITE_SPCS_BASE=https://<spcs-endpoint>
