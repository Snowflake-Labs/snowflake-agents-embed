{
  // The shared core is runtime-neutral: standard Fetch types plus KvLike. This config checks
  // it against Node types; tsconfig.workers.json checks it again with the Worker entry
  // against workers-types, so a Workers-only or Node-only API in src/core fails one of them.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/core"],
  "exclude": ["src/**/*.test.ts"]
}
