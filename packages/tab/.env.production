# Tab build-time config (public — no secrets). Tracked on purpose: keep every value empty here.
# All /api/* calls use relative URLs — intercepted by the edge Worker's proxy
# (packages/teams-edge/src/core/api-proxy.ts), which forwards server-to-server to SPCS.
# SPCS_BASE (the actual SPCS URL) is an edge runtime secret set by set-edge-secrets.sh.
VITE_EDGE_BASE=
VITE_SPCS_BASE=
VITE_TEAMS_APP_ID=
